# =============================================================================
# The Blue Legacy Foundation — environment variables
# Copy to `.env` for local development. NEVER commit real values.
# On Vercel, set these under Project → Settings → Environment Variables.
# =============================================================================

# --- Database (required) -----------------------------------------------------
# PostgreSQL connection string used by the app at runtime.
# On Vercel, connecting a Neon database from the Storage tab sets this (and DATABASE_URL_UNPOOLED,
# used for migrations) automatically — you do not need to add it by hand.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/blue_legacy"
# Optional: direct (non-pooled) connection used by `prisma migrate deploy`.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/blue_legacy"

# Separate database for integration and Playwright tests. Its name MUST contain
# "test" — the test tooling refuses to touch any other database because it empties it.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/blue_legacy_test"

# --- Site --------------------------------------------------------------------
# Public base URL, used for canonical links, sitemap, OpenGraph and email links.
# Optional on Vercel: defaults to the project's production domain. Set it when you add your own domain.
# Note: NEXT_PUBLIC_* values are embedded at build time.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret used to hash client IP addresses for rate limiting (raw IPs are never stored).
# Optional: when empty, a stable secret is derived from the database credentials.
# Generate your own with: openssl rand -hex 32
RATE_LIMIT_SALT=""

# Set to "true" to take the public site offline: every public page shows a bilingual holding page
# (HTTP 503, not indexed). /admin keeps working so content can still be edited. Remove to go live.
# SITE_OFFLINE="true"

# Set to "true" on any production deployment that is not on Vercel
# (Vercel sets VERCEL_ENV=production automatically). Disables the mock payment provider.
# PRODUCTION_DEPLOYMENT="true"

# --- Email notifications (optional) ------------------------------------------
# Enquiries are ALWAYS stored in the database first. When these are blank, the admin
# dashboard shows enquiries with email status NOT_CONFIGURED.
RESEND_API_KEY=""
# Must be a sender on a domain verified in Resend, e.g. "Blue Legacy <notifications@yourdomain.org>"
EMAIL_FROM=""
# Staff inbox that receives new-enquiry notifications.
NOTIFICATION_EMAIL=""

# --- Donations (DISABLED by default) -----------------------------------------
# Donations stay disabled unless ALL of the following are true:
#   1. FEATURE_DONATIONS_ENABLED="true"
#   2. DONATIONS_COMPLIANCE_CONFIRMED="true" — set ONLY after the entity is incorporated,
#      has a bank account in its own name, Stripe has verified it, and donation terms and
#      receipt wording have been approved by Italian legal/tax advisers (see LAUNCH_CHECKLIST.md)
#   3. Stripe keys and webhook secret are configured below.
FEATURE_DONATIONS_ENABLED="false"
DONATIONS_COMPLIANCE_CONFIRMED="false"

# "stripe" (default) or "mock". The mock provider is for automated tests and local demos only;
# it also requires ALLOW_MOCK_PAYMENTS="true" and is always refused in production.
PAYMENTS_MODE="stripe"
ALLOW_MOCK_PAYMENTS="false"

# Stripe secret key (sk_test_... for testing, sk_live_... in production). Server-side only.
STRIPE_SECRET_KEY=""
# Signing secret of the webhook endpoint https://YOUR_DOMAIN/api/stripe/webhook
# (Stripe Dashboard → Developers → Webhooks), or from `stripe listen` locally.
# Subscribe to: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired, charge.refunded
STRIPE_WEBHOOK_SECRET=""

# --- Analytics (optional, consent-based) --------------------------------------
# When set, a consent banner is shown and Plausible is loaded ONLY after the visitor opts in.
# When blank, no banner is shown and no analytics are loaded (technical cookies only).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
# NEXT_PUBLIC_PLAUSIBLE_SRC="https://plausible.io/js/script.js"

# --- Seeding & admin bootstrap (optional) -------------------------------------
# If both are set, `npm run db:seed` (which also runs on every Vercel deploy) creates this ADMIN user.
# Existing passwords are never overwritten. You can remove SEED_ADMIN_PASSWORD after the first deploy.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME=""
